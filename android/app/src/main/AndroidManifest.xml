<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- APRSlocus 权限 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- 蓝牙：经典蓝牙 SPP（TNC / PKWDWPL）+ BLE 心率带（标准心率服务 0x180D）。
         Android 12（API 31）起蓝牙权限拆分为运行时权限 BLUETOOTH_CONNECT / _SCAN；
         旧版本仍用 BLUETOOTH / BLUETOOTH_ADMIN，故用 maxSdkVersion 限定作用域。
         经典蓝牙侧只用「已配对设备 + 建立 RFCOMM」，**不做经典蓝牙发现**
         （startDiscovery 会打断正在工作的 SPP 连接，见 BleHrManager 的注释）；
         BLE 侧要扫描心率带，但只按标准心率服务 0x180D 过滤。
         neverForLocation 仍然成立：BLE 扫描只为找心率带、不用于推断位置 ——
         声明它才不会在 Android 12+ 上额外索要定位权限（否则用户会看到一个
         「找心率带为什么要位置」的弹窗，很容易被当成隐私问题而拒绝）。
         注意：Android 11 及以下 BLE 扫描**仍然**需要 ACCESS_FINE_LOCATION
         （系统行为，绕不过去），该权限本文件上面已声明。 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s"/>
    <uses-feature android:name="android.hardware.bluetooth" android:required="false"/>
    <!-- BLE（心率广播设备）：同样 required=false —— 没有 BLE 的设备必须能正常
         安装使用，只是设置里的「心率」一档会显示「本机不支持」。 -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false"/>
    <!-- BLE 心率带：required=false 是**必须的**，理由同下面的 USB / 传感器 ——
         写 true（或漏写）会让没有 BLE 的机型在应用市场里被直接过滤掉，
         而它们在功能上完全可用，只是没有心率带支持。 -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false"/>

    <!-- 音频数据来源（声卡 TNC / AFSK 1200）：
         RECORD_AUDIO 采集电台/声卡的音频做解调；MODIFY_AUDIO_SETTINGS 用于读取
         音频参数。Android 14（API 34）起，带 microphone 类型的前台服务还需
         单独声明 FOREGROUND_SERVICE_MICROPHONE，否则应用退到后台后会被系统
         掐断麦克风（表现：切后台就再也收不到报文）。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- 蓝牙 SPP（TNC / PKWDWPL）：与音频同一个坑 —— Android 14（API 34）起，
         前台服务中访问蓝牙设备需声明 connectedDevice 类型，否则退到后台后
         系统会限制蓝牙访问（表现：切后台就收不到报文 / 只能发不能收）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <!-- 运动传感器（加速度计 / 指南针）：用于「轨迹打点更准」——
         低速时用指南针补航向、用加速度计判断是否真的在动。
         没有这些传感器的设备必须能正常安装使用（required=false）。 -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false"/>
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false"/>

    <!-- USB 串口（USB-OTG 硬件串口）：
         required=false 是**必须的** —— 没写或写 true 会让没有 OTG 的设备
         （部分机型、Windows 之外的平台）在应用市场里被直接过滤掉。
         枚举/打开走 UsbManager（系统会弹一次授权），无需任何存储权限；
         设备过滤表只用于「插线时系统询问用哪个应用打开」，见 usb_device_filter.xml。 -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>
    <uses-feature android:name="android.hardware.usb.accessory" android:required="false"/>

    <application
        android:label="APRSlocus"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- 「分享给 APRSlocus」：注册 text/plain 的 ACTION_SEND，佳明 App
                 的分享面板里就会出现本应用，用户点一下链接就落到设置里。
                 分享进来的文本一律透传给 Dart（那边识别不了会如实提示）——
                 原生侧不再按域名过滤，避免「佳明换了域名」变成静默丢弃。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- USB 串口：插上线时系统能直接列出本应用（便利，不是必需 ——
                 不写也能在应用内枚举到设备，只是要先进应用再插线）。
                 过滤表见 res/xml/usb_device_filter.xml。 -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
            <!-- 分享入口：佳明 App 的 LiveTrack 链接可以直接分享进本应用。
                 只能声明成「接收任意 text/plain 分享」—— 系统没提供按宿主 App
                 过滤的能力，所以 APRSlocus 会出现在**所有**文本分享的目标里。
                 真正的闸门在 MainActivity.readSharedText（只认
                 livetrack.garmin.com），其它内容一律安静忽略。 -->
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- 桌面小组件：天气 + 业余无线电提示（4 列 × 2 行）。
             exported=true 是必须的 —— 组件由系统（Launcher / AppWidgetService）
             实例化，不是本应用自己；但它只读自己进程内的 SharedPreferences、
             不接受任何外部数据，所以没有暴露面。
             不要给它加 android:permission，否则部分启动器会因缺少权限而无法
             实例化组件（表现：列表里能看到，拖到桌面却没反应）。 -->
        <receiver
            android:name=".WeatherWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aprslocus_weather_widget_info" />
        </receiver>
        <!-- 短波/电离层传播组件（4×2 固定尺寸）。
             exported=true 必须：组件由系统实例化。它只读自己进程内的
             SharedPreferences、不接受外部数据，所以没有暴露面。 -->
        <receiver
            android:name=".HfWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aprslocus_hf_widget_info" />
        </receiver>
        <!-- 系统状态组件（4×2 固定尺寸）：定位 / 四条链路 / 收发计数 / 信标。
             exported=true 必须（系统实例化）；它只读自己进程内的
             SharedPreferences、不接受外部数据，没有暴露面。 -->
        <receiver
            android:name=".SysWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aprslocus_sys_widget_info" />
        </receiver>
        <service
            android:name=".LocationService"
            android:exported="false"
            android:foregroundServiceType="location|microphone|connectedDevice"
            android:stopWithTask="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="androidamap"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="amapuri"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
    </queries>
</manifest>
