<?xml version="1.0" encoding="utf-8"?>
<!--
  ═══════════════════════════════════════════════════════════════════════
  APRSlocus 桌面小组件布局 —— 4 列 × 2 行（天气 + 业余无线电提示）
  ═══════════════════════════════════════════════════════════════════════

  结构（字段一一对应 lib/app_widget.dart 产出的快照）：

    顶栏   📍北京  [AQI 42 优]                      观测 14:30
    ──────────────────────────────────────────────────────────────
    第 1 行 [🌤 23° 晴 12°/25°] [💧45% 湿度] [🌡1013 气压] [🌬3级 风力]
    第 2 行 [⚡ 安全警示 / 雷雨天气：…]  ×4

  ⚠ 四条硬约束（都不是风格问题，踩了直接崩或白屏）：

  ① **只能用 RemoteViews 支持的那几个布局/控件**。这里全部是
     FrameLayout + LinearLayout + TextView/View，宽度一律靠 `layout_weight`
     分配。ConstraintLayout、RecyclerView、自定义 View 都不在支持列表里。

  ② **不能用 styles.xml 的主题样式**（Theme.* 那一类）。RemoteViews 由
     系统进程 inflate，读不到应用主题，未知属性会直接抛异常。
     因此字号/颜色全部就地写死，不做抽取。

  ③ **不能用 <selector> / ripple 当背景**。aw_bg_*、aw_tile*、aw_pill 都是
     普通 <shape>；带状态选择的 drawable 在 RemoteViews 里 inflate 会抛异常。
     所以「危险级提示格」是换一张 drawable（aw_tile_danger），不是加 selector。

  ④ **不要引用 @color/@dimen 之外的资源类型**；文字阴影（shadowColor/…）
     在部分 ROM 的 RemoteViews 上表现不一致，这里整体不用。

  背景 `aw_bg_cloudy` 只是默认占位；运行时 Kotlin 按快照里的 `kind` 换成
  aw_bg_{clear,cloudy,overcast,rain,storm,snow,fog} 之一。深色版本在
  drawable-night/，由 tool/gen_app_widget_drawables.py 统一生成 ——
  改配色请改那个脚本，别在这里手改，否则会和天气面板的渐变分叉。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aw_bg_cloudy">

    <LinearLayout
        android:id="@+id/aw_pad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="7dp">

        <!-- ══ 顶栏：📍城市 · AQI 胶囊 · 观测时刻 ══ -->
        <LinearLayout
            android:id="@+id/aw_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/aw_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="110dp"
                android:textColor="#F2FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/aw_aqi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/aw_pill"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <!-- 占位撑开用：**必须**是真控件。
                 不能用 <View> —— 原生 View 不在 RemoteViews 支持的
                 View 列表里，inflate 时会抛
                 "android.view.View is not allowed"，整个组件变白块。 -->
            <TextView
                android:id="@+id/aw_spacer"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/aw_observed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#B8FFFFFF"
                android:textSize="8.5sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- ══ 空状态：无定位 / 还没同步过天气时只显示这一行 ══ -->
        <TextView
            android:id="@+id/aw_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="3"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.35"
            android:textColor="#E6FFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />

        <!-- ══ 有数据时的主体（4 列 × 2 行）══ -->
        <LinearLayout
            android:id="@+id/aw_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- ── 第 1 行：天气主格 + 3 个指标格 ── -->
            <LinearLayout
                android:id="@+id/aw_row1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.05"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/aw_hero"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.4"
                    android:layout_marginEnd="3dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/aw_tile"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <TextView
                        android:id="@+id/aw_hero_emoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textSize="13sp"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/aw_hero_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/aw_hero_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#D9FFFFFF"
                        android:textSize="8sp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- 指标格 0 -->
                <LinearLayout
                    android:id="@+id/aw_m0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/aw_tile"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <TextView
                        android:id="@+id/aw_m0_emoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textSize="11sp"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/aw_m0_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/aw_m0_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#C4FFFFFF"
                        android:textSize="8sp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- 指标格 1 -->
                <LinearLayout
                    android:id="@+id/aw_m1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/aw_tile"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <TextView
                        android:id="@+id/aw_m1_emoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textSize="11sp"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/aw_m1_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/aw_m1_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#C4FFFFFF"
                        android:textSize="8sp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- 指标格 2 -->
                <LinearLayout
                    android:id="@+id/aw_m2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/aw_tile"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <TextView
                        android:id="@+id/aw_m2_emoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textSize="11sp"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/aw_m2_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/aw_m2_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#C4FFFFFF"
                        android:textSize="8sp"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── 第 2 行：业余无线电提示 ×4 ──
                 每格两段：上排「emoji + 级别」（级别用该条建议的色相上色），
                 下面 2 行正文（长句由系统省略号截断 —— 中文建议的
                 前半句通常就是结论，例如「雷雨天气：请勿在室外架设/操作天线！」）。 -->
            <LinearLayout
                android:id="@+id/aw_row2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/aw_tip0_box"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:background="@drawable/aw_tile"
                    android:paddingStart="4dp"
                    android:paddingEnd="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false">

                        <TextView
                            android:id="@+id/aw_tip0_emoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textSize="10sp"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/aw_tip0_level"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="3dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/aw_tip0_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="#EDFFFFFF"
                        android:textSize="8sp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/aw_tip1_box"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:background="@drawable/aw_tile"
                    android:paddingStart="4dp"
                    android:paddingEnd="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false">

                        <TextView
                            android:id="@+id/aw_tip1_emoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textSize="10sp"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/aw_tip1_level"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="3dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/aw_tip1_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="#EDFFFFFF"
                        android:textSize="8sp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/aw_tip2_box"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:background="@drawable/aw_tile"
                    android:paddingStart="4dp"
                    android:paddingEnd="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false">

                        <TextView
                            android:id="@+id/aw_tip2_emoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textSize="10sp"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/aw_tip2_level"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="3dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/aw_tip2_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="#EDFFFFFF"
                        android:textSize="8sp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/aw_tip3_box"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:background="@drawable/aw_tile"
                    android:paddingStart="4dp"
                    android:paddingEnd="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false">

                        <TextView
                            android:id="@+id/aw_tip3_emoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textSize="10sp"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/aw_tip3_level"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="3dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/aw_tip3_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="#EDFFFFFF"
                        android:textSize="8sp"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
