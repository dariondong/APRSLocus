<!--
  桌面小组件 · 主档（4×2）—— 「主面板」

  3~4 格宽 × 2 格高的主力档位，排布对齐 App 内天气面板的「顶部区」：
    顶栏（城市 · AQI · 观测时刻）
    左：大温度 + 天气现象 + 今日高低温    右：2×2 指标格
    底：2 条通栏提示行（危险优先，级别色圆点 + 正文）
  
  为什么提示只放 2 条而不是 4 条：面板里每条建议占一整行、正文 12sp；
  组件高度只有 2 格，塞 4 行会把每条压成 1 行 8sp —— 那正是上一版的「挤」。
  宁可少给两条，也要让给出的两条读得舒服（完整列表点进 App 看）。
  
  ⚠ 硬约束同 compact 档。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aw_bg_cloudy">
    <LinearLayout
        android:id="@+id/aw_pad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
    <LinearLayout
        android:id="@+id/aw_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">
    <TextView
        android:id="@+id/aw_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#F2FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxWidth="120dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:includeFontPadding="false" />
    <TextView
        android:id="@+id/aw_aqi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:background="@drawable/aw_pill"
        android:textColor="#FFFFFF"
        android:textSize="8.5sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:includeFontPadding="false" />
    <TextView
        android:id="@+id/aw_spacer"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:textColor="#FFFFFF"
        android:textSize="1sp"
        android:singleLine="true"
        android:includeFontPadding="false" />
    <TextView
        android:id="@+id/aw_observed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#B8FFFFFF"
        android:textSize="8.5sp"
        android:singleLine="true"
        android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/aw_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">
    <LinearLayout
        android:id="@+id/aw_left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.12"
        android:layout_marginEnd="10dp"
        android:gravity="center_vertical"
        android:orientation="vertical">
    <LinearLayout
        android:id="@+id/aw_b_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">
    <TextView
        android:id="@+id/aw_b_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:singleLine="true"
        android:includeFontPadding="false" />
    <LinearLayout
        android:id="@+id/aw_b_temp_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:baselineAligned="false">
    <TextView
        android:id="@+id/aw_b_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02"
        android:singleLine="true"
        android:includeFontPadding="false" />
    <TextView
        android:id="@+id/aw_b_deg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:text="°"
        android:singleLine="true"
        android:includeFontPadding="false" />
    </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/aw_b_cond"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#E0FFFFFF"
        android:textSize="9.5sp"
        android:singleLine="true"
        android:includeFontPadding="false" />
    <TextView
        android:id="@+id/aw_b_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="#C4FFFFFF"
        android:textSize="9sp"
        android:singleLine="true"
        android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/aw_b_metrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">
    <LinearLayout
        android:id="@+id/aw_mrow0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
    <LinearLayout
        android:id="@+id/aw_m0"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/aw_tile"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">
    <TextView
        android:id="@+id/aw_m0_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:includeFontPadding="false" />
    <TextView
        android:id="@+id/aw_m0_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#C4FFFFFF"
        android:textSize="7.5sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/aw_m1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/aw_tile"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">
    <TextView
        android:id="@+id/aw_m1_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:includeFontPadding="false" />
    <TextView
        android:id="@+id/aw_m1_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#C4FFFFFF"
        android:textSize="7.5sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:includeFontPadding="false" />
    </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/aw_mrow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
    <LinearLayout
        android:id="@+id/aw_m2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/aw_tile"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">
    <TextView
        android:id="@+id/aw_m2_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:includeFontPadding="false" />
    <TextView
        android:id="@+id/aw_m2_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#C4FFFFFF"
        android:textSize="7.5sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/aw_m3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/aw_tile"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">
    <TextView
        android:id="@+id/aw_m3_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:includeFontPadding="false" />
    <TextView
        android:id="@+id/aw_m3_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#C4FFFFFF"
        android:textSize="7.5sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:includeFontPadding="false" />
    </LinearLayout>
    </LinearLayout>
    </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/aw_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="vertical">
    <LinearLayout
        android:id="@+id/aw_tip0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        android:baselineAligned="false">
    <TextView
        android:id="@+id/aw_tip0_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/aw_dot"
        android:textColor="#FFFFFF"
        android:textSize="1sp"
        android:singleLine="true"
        android:includeFontPadding="false" />
    <LinearLayout
        android:id="@+id/aw_tip0_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">
    <LinearLayout
        android:id="@+id/aw_tip0_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
    <TextView
        android:id="@+id/aw_tip0_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:singleLine="true"
        android:includeFontPadding="false" />
    <TextView
        android:id="@+id/aw_tip0_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textColor="#FFFFFF"
        android:textSize="8.5sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:singleLine="true"
        android:includeFontPadding="false" />
    </LinearLayout>
    <TextView
        android:id="@+id/aw_tip0_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#EDFFFFFF"
        android:textSize="9.5sp"
        android:maxLines="3"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.3"
        android:includeFontPadding="false" />
    </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/aw_tip1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="top"
        android:orientation="horizontal"
        android:baselineAligned="false">
    <TextView
        android:id="@+id/aw_tip1_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/aw_dot"
        android:textColor="#FFFFFF"
        android:textSize="1sp"
        android:singleLine="true"
        android:includeFontPadding="false" />
    <LinearLayout
        android:id="@+id/aw_tip1_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">
    <LinearLayout
        android:id="@+id/aw_tip1_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
    <TextView
        android:id="@+id/aw_tip1_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:singleLine="true"
        android:includeFontPadding="false" />
    <TextView
        android:id="@+id/aw_tip1_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textColor="#FFFFFF"
        android:textSize="8.5sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:singleLine="true"
        android:includeFontPadding="false" />
    </LinearLayout>
    <TextView
        android:id="@+id/aw_tip1_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#EDFFFFFF"
        android:textSize="9.5sp"
        android:maxLines="3"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.3"
        android:includeFontPadding="false" />
    </LinearLayout>
    </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/aw_tip_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:visibility="gone">
    <TextView
        android:id="@+id/aw_tipc_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:singleLine="true"
        android:includeFontPadding="false" />
    <TextView
        android:id="@+id/aw_tipc_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="5dp"
        android:textColor="#EDFFFFFF"
        android:textSize="9.5sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:includeFontPadding="false" />
    </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/aw_empty"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#E6FFFFFF"
        android:textSize="10sp"
        android:maxLines="4"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.35"
        android:visibility="gone"
        android:includeFontPadding="false" />
</FrameLayout>
