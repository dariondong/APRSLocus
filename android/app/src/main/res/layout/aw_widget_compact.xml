<!--
  桌面小组件 · 紧凑档（2×2 / 2×3）

  温度 + 天气现象 + 高低温，下面一条「最要紧」的建议。
  
  提示只给一条：小尺寸下把 4 条并列等于每条都看不清，所以只显示排序后的
  第 1 条（危险 → 注意 → 通联机会 → 操作提示）。
  
  ⚠ 硬约束同主档。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aw_bgs_cloudy">
    <LinearLayout
        android:id="@+id/aw_pad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
    <LinearLayout
        android:id="@+id/aw_header1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">
    <ImageView
        android:id="@+id/aw_city_icon"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/aw_ic_place" />
    <TextView
        android:id="@+id/aw_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:textColor="@color/aw_ink"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:includeFontPadding="false" />
    <TextView
        android:id="@+id/aw_spacer1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:textColor="@color/aw_ink"
        android:textSize="1sp"
        android:singleLine="true"
        android:includeFontPadding="false" />
    <ImageView
        android:id="@+id/aw_logo"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:scaleType="fitCenter"
        android:src="@drawable/aw_logo" />
    <TextView
        android:id="@+id/aw_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textColor="@color/aw_ink"
        android:textSize="11sp"
        android:text="APRSlocus"
        android:textStyle="bold"
        android:singleLine="true"
        android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/aw_header2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">
    <LinearLayout
        android:id="@+id/aw_aqi_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/aw_pill"
        android:paddingStart="7dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
    <ImageView
        android:id="@+id/aw_aqi_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/aw_dot" />
    <TextView
        android:id="@+id/aw_aqi_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:textColor="@color/aw_ink"
        android:textSize="8sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:includeFontPadding="false" />
    </LinearLayout>
    <TextView
        android:id="@+id/aw_spacer2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:textColor="@color/aw_ink"
        android:textSize="1sp"
        android:singleLine="true"
        android:includeFontPadding="false" />
    <TextView
        android:id="@+id/aw_observed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/aw_ink"
        android:textSize="8sp"
        android:singleLine="true"
        android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/aw_rule1_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="vertical">
    <TextView
        android:id="@+id/aw_rule1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/aw_hero_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">
    <ImageView
        android:id="@+id/aw_hero_icon"
        android:layout_width="21dp"
        android:layout_height="21dp"
        android:scaleType="fitCenter"
        android:src="@drawable/aw_ic_big_thunderstorm" />
    <TextView
        android:id="@+id/aw_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:textColor="@color/aw_ink"
        android:textSize="25sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02"
        android:singleLine="true"
        android:includeFontPadding="false" />
    <LinearLayout
        android:id="@+id/aw_cond_box"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:orientation="vertical">
    <TextView
        android:id="@+id/aw_cond"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/aw_ink"
        android:textSize="9sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:includeFontPadding="false" />
    <TextView
        android:id="@+id/aw_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="@color/aw_ink"
        android:textSize="8.5sp"
        android:singleLine="true"
        android:includeFontPadding="false" />
    </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/aw_rule2_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="vertical">
    <TextView
        android:id="@+id/aw_rule2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/aw_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="vertical">
    <LinearLayout
        android:id="@+id/aw_tip0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        android:baselineAligned="false">
    <ImageView
        android:id="@+id/aw_tip0_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/aw_dot" />
    <LinearLayout
        android:id="@+id/aw_tip0_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">
    <LinearLayout
        android:id="@+id/aw_tip0_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
    <ImageView
        android:id="@+id/aw_tip0_icon"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/aw_ic_rss_feed" />
    <TextView
        android:id="@+id/aw_tip0_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textColor="@color/aw_ink"
        android:textSize="8sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:singleLine="true"
        android:includeFontPadding="false" />
    </LinearLayout>
    <TextView
        android:id="@+id/aw_tip0_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/aw_ink"
        android:textSize="8.5sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.3"
        android:includeFontPadding="false" />
    </LinearLayout>
    </LinearLayout>
    </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/aw_empty"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="@color/aw_ink"
        android:textSize="10sp"
        android:maxLines="4"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.35"
        android:visibility="gone"
        android:includeFontPadding="false" />
</FrameLayout>
