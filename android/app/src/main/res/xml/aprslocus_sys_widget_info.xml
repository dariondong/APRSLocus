<?xml version="1.0" encoding="utf-8"?>
<!--
  APRSlocus 系统状态 桌面小组件（4×2）

  固定尺寸（resizeMode=none）：内容是「身份 / 四条链路 / 计数」三段，
  与短波组件同理 —— 挤到 2×2 会把链路区压掉，而那正是本组件的主要价值。
  与其提供一个会被拖坏的组件，不如老实声明尺寸。

  updatePeriodMillis 取系统最小值 30 分钟：它**不联网**，只重渲染已有快照，
  顺带让组件在存储异常后能自愈。真正刷新由 App 侧推送。
-->
<!-- 缩放适配（说明写在标签之外：XML 注释不能出现在属性之间）
  同短波：最小尺寸取内容放得下的下限（高 125dp / 宽 170dp）。
  拉高到 3 格以上换 aw_widget_sys_tall：字号上一档、状态点变大、各区块之间拉开
  —— 这个组件没有「可以多给的内容」，所以把高度用在可读性上。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:minResizeWidth="170dp"
    android:minResizeHeight="125dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/aw_widget_sys"
    android:previewLayout="@layout/aw_widget_sys"
    android:description="@string/app_widget_sys_desc"
    android:widgetCategory="home_screen" />
