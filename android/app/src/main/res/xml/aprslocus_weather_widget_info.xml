<?xml version="1.0" encoding="utf-8"?>
<!--
  APRSlocus 天气 + 无线电提示 桌面小组件

  **可自由缩放**：默认落位 4×2，但同一份 widget 会根据当前尺寸自动换布局，
  共 4 档（见 WeatherWidgetProvider.tierFor）：
     2×2 / 2×3  → aw_widget_compact   温度 + 天气 + 1 条最要紧的提示
     3~4×1      → aw_widget_row       单行通栏
     2×4        → aw_widget_tall      「小面板」：温度 + 指标 + 堆叠提示
     3~4×2      → aw_widget_tile      「主面板」：左温度 / 右指标 / 底提示

  尺寸口径：
  - `targetCellWidth/Height`（API 31+）用「格子数」声明默认落位，是正式口径；
  - `minWidth/minHeight`（dp）给旧版本兜底，按 (74×格子数 − 16) 换算，4×2 ≈ 280×132dp；
  - `minResizeWidth/Height` 决定用户最少能拖到多小。这里给到约 2×1 格：
    再小下去连单行档都排不下（温度 + 天气 + 提示三者会互相挤掉）。
    **不要**为了「看起来自由」把它设成 1 格宽 —— 那样用户能拖出一个
    什么都显示不出来的组件，而他会以为是 App 坏了。

  `updatePeriodMillis` 取系统允许的最小值 30 分钟：它**不会**重新联网取
  天气（组件不持有和风密钥，见 lib/app_widget.dart），只是重新渲染一遍已有
  快照，顺带让组件在存储/数据异常后能自愈。真正的数据刷新由 App 侧推送
  （AppWidgetBridge.push）。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="60dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/aw_widget_tile"
    android:previewLayout="@layout/aw_widget_tile"
    android:description="@string/app_widget_weather_desc"
    android:widgetCategory="home_screen" />
