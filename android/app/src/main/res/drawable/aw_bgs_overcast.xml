<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- 天气档位：overcast（小尺寸版，圆角 16dp；2×2 / 4×1 档用） -->
    <corners android:radius="16dp" />
    <!-- angle=270：从上到下。Android 角度里 0=左→右、90=下→上、270=上→下 -->
    <gradient
        android:angle="270"
        android:type="linear"
        android:startColor="#56677A"
        android:endColor="#8C9BAB" />
</shape>
